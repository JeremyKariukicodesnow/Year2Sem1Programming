# 1. Create a new project directory (if you haven't already)
mkdir my_python_project
cd my_python_project

check versions 
py -0p

# 2. Create a virtual environment using Python 3.13
py -3.13 -m venv .venv

# 3. Activate the virtual environment
.venv\Scripts\activate

# (Your prompt should now show (.venv) in front)

# 4. Install dependencies (assuming you have a requirements.txt file)
pip install -r requirements.txt

# 5. Run your Python script (e.g., your_script.py)
python your_script.py

# 6. Deactivate the virtual environment when done (optional)
deactivate